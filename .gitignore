# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/
.gradle/
.idea/
.fleet/

# Gradle build outputs
build/

# Local machine settings (SDK path, etc.)
local.properties

# IDE
*.iml

# Android Studio run/capture output
captures/
.externalNativeBuild/
.cxx/

# Signing / secrets (never commit)
*.keystore
*.jks
secrets.properties
keystore.properties

# Profiling / crash dumps
*.hprof

# OS junk
.DS_Store
Thumbs.db
Desktop.ini
